#!/usr/bin/env python3
"""hv: fzf views over herdr agents, their GitHub PRs, and the links they mentioned.

    hv [agents|refs|prs]

Also, as a background refresher started by the plugin's startup hook:

    hv _annotate_loop

And for the travel keys, which plugin actions call:

    hv tree              spaces > tabs > agents as a foldable tree; enter travels
    hv back | forward    step through the panes you have focused, like a browser
    hv needs-you         go to the agent at the top of the "needs you" queue

Stdlib only, and Python 3.7 compatible, so it runs on whatever python3 is
already on the machine.

Three things it does that herdr cannot do by itself:

1. agents  - an fzf switcher over every agent, with a live preview of its pane
             so you can see what one is doing before travelling to it.
2. spaces  - writes each space's agents into workspace metadata, so the
             spaces panel reads as a tree. Herdr has no tree or fold API; this
             fakes it with a fixed set of rows.
3. queue   - filters herdr's Agents panel down to agents that are blocked or
             done, which is the set that wants a human.
4. history - remembers the panes you focus, so back and forward can retrace
             them across tabs and spaces. Herdr keeps no such history.
"""

import contextlib
import fcntl
import glob
import json
import os
import re
import shlex
import shutil
import socket
import threading
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or HOME + "/.cache", "herdr-views")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config", "herdr-views", "config.json")
SELF = os.path.abspath(__file__)
# A plugin pane inherits the herdr server's PATH, which lacks what an
# interactive shell adds. fzf and gh are usually in one of these.
os.environ["PATH"] = os.pathsep.join([
    HOME + "/.local/bin", HOME + "/.fzf/bin", "/opt/homebrew/bin", "/usr/local/bin",
    os.environ.get("PATH", "")])

RED, GREEN, YELLOW, BLUE, MAGENTA, CYAN, DIM, BOLD = "31", "32", "33", "34", "35", "36", "2", "1"
STATUS_COLOR = {"blocked": RED, "working": YELLOW, "done": GREEN, "idle": DIM, "unknown": DIM}
STATUS_GLYPH = {"blocked": "!", "working": "◐", "done": "✓", "idle": "○", "unknown": "?"}
SPACE_GLYPH = {"blocked": "●", "working": "◐", "done": "✓", "idle": "○", "unknown": "○"}

MODES = {
    "agents": "enter: travel to it · ctrl-r: its refs",
    "prs": "enter: open in the browser",
    "refs": "enter: open in the browser",
}
KEYS = "ctrl-a agents · ctrl-p PRs · ctrl-r refs · ctrl-o open · ctrl-y copy · ctrl-l reload"

# Rows available per space in the sidebar template, plus one for the "+N more".
SPACE_ROWS = 6
SIDEBAR_TEXT = 34  # sidebar_width 38, less the row's own padding
ANNOTATE_SOURCE = "hv"
TOKEN_TTL_MS = 3600000
# Agent status changes in seconds, so the tree has to be rewritten often or it
# shows "idle" beside an agent that is plainly working.
STATUS_EVERY = 5
# The PR list is comparatively expensive, so it runs on a slower beat.
PR_EVERY = 120
TOKEN_NAMES = ("hv_pr", "hv_pr_state")
PR_TTL = 120


# ---- plumbing

def c(text, code):
    return "\033[{}m{}\033[0m".format(code, text)


def row(kind, ident, url, aux, display):
    """One tab-delimited record per line. fzf shows field 5 and we act on the rest."""
    fields = [kind, ident, url or "", aux or "", display]
    print("\t".join(re.sub(r"[\t\r\n]+", " ", str(f)) for f in fields))


def message(text, color=DIM, url=""):
    row("msg", "", url, "", c(text, color))


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (IOError, OSError, ValueError):
        return default


def save(path, value):
    """Writes atomically through a temp file of its own, so two processes
    saving the same file never truncate each other's temp or leave it half-written."""
    try:
        os.makedirs(os.path.dirname(path))
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


@contextlib.contextmanager
def locked(path):
    """Holds an exclusive lock on path's .lock file for a read-modify-write."""
    try:
        os.makedirs(os.path.dirname(path))
    except OSError:
        pass
    with open(path + ".lock", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def config():
    cfg = {"open_cmd": None, "pr_search": "--author=@me --state=open"}
    cfg.update(load(CONFIG, {}))
    return cfg


def state():
    return load(os.environ.get("HV_STATE", ""), {"mode": "agents"})


def set_state(**changes):
    st = state()
    st.update(changes)
    save(os.environ["HV_STATE"], st)
    return st


def herdr(*args):
    r = subprocess.run(["herdr"] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, universal_newlines=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip()[:300] or "herdr {} failed".format(" ".join(args)))
    return json.loads(r.stdout)["result"] if r.stdout.strip() else {}


def socket_request(method, params):
    """One request over herdr's socket, for the few APIs the CLI does not wrap."""
    path = os.environ.get("HERDR_SOCKET_PATH") or os.path.join(HOME, ".config", "herdr", "herdr.sock")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(10)
    try:
        sock.connect(path)
        sock.sendall((json.dumps({"id": "hv", "method": method, "params": params}) + "\n").encode("utf-8"))
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                raise RuntimeError("herdr closed the socket")
            buf += chunk
    finally:
        sock.close()
    reply = json.loads(buf.split(b"\n")[0].decode("utf-8"))
    if "error" in reply:
        raise RuntimeError(str(reply["error"])[:300])
    return reply.get("result") or {}


def plugin_context():
    """What herdr injects when hv runs as a plugin pane; empty from a shell.

    A popup is not a pane, so this is the only reliable way to learn which pane
    the user opened hv from.
    """
    try:
        return json.loads(os.environ.get("HERDR_PLUGIN_CONTEXT_JSON") or "{}")
    except ValueError:
        return {}


def agent_panes():
    spaces = {w["workspace_id"]: w.get("label") or "?" for w in herdr("workspace", "list")["workspaces"]}
    tabs = {t["tab_id"]: t.get("label") or "?" for t in herdr("tab", "list")["tabs"]}
    out = []
    for p in herdr("pane", "list")["panes"]:
        p["where"] = "{} / {}".format(spaces.get(p["workspace_id"], "?"), tabs.get(p["tab_id"], "?"))
        out.append(p)
    return out


def to_clipboard(text):
    """OSC 52, so it reaches the machine running the terminal even over ssh."""
    import base64
    payload = base64.b64encode(text.encode("utf-8")).decode("ascii")
    sys.stderr.write("\033]52;c;{}\a".format(payload))
    sys.stderr.flush()
    return "copied"


def open_urls(urls):
    cmd = config()["open_cmd"] or ("open" if sys.platform == "darwin" else "xdg-open")
    if not shutil.which(cmd.split()[0]):
        return to_clipboard("\n".join(urls)) + " (no " + cmd + " here)"
    for url in urls:
        subprocess.Popen(shlex.split(cmd) + [url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return "opened {}".format(len(urls))


# ---- agents

def list_agents():
    """One row per agent pane. Shell panes are left out: they were noise."""
    for p in agent_panes():
        if not p.get("agent"):
            continue
        status = p.get("agent_status") or "unknown"
        tokens = p.get("tokens") or {}
        pr = tokens.get("hv_pr", "")
        row("pane", p["pane_id"], "", p["tab_id"], "{} {} {} {} {}".format(
            c(STATUS_GLYPH.get(status, " "), STATUS_COLOR.get(status, DIM)),
            "{:<34}".format(p["where"][:34]),
            c("{:<8}".format(status), STATUS_COLOR.get(status, DIM)),
            "{:<22}".format((p.get("terminal_title_stripped") or "")[:22]),
            c(pr, DIM)))


# ---- refs: the links an agent session mentioned

REF_PATTERNS = [
    ("pr", re.compile(r"https://github\.com/([^/\s]+/[^/\s]+/pull/\d+)")),
    ("issue", re.compile(r"https://github\.com/([^/\s]+/[^/\s]+/issues/\d+)")),
    ("repo", re.compile(r"https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)(?:\s|$|\))")),
    ("link", re.compile(r"(https?://[^\s\"'\\<>)\]`]+)")),
]
REF_URL = {"pr": "https://github.com/", "issue": "https://github.com/",
           "repo": "https://github.com/", "link": ""}
REF_KINDS = [("pr", "PR"), ("issue", "issue"), ("repo", "repo"), ("link", "link")]
# A big tool result is a file dump or a search, whose links were not really
# "mentioned" by the session.
MAX_RESULT_CHARS = 4000


def transcript(session_id):
    found = glob.glob(os.path.join(HOME, ".claude", "projects", "*", session_id + ".jsonl"))
    return found[0] if found else None


def spoken(entry):
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        yield content
    for block in content if isinstance(content, list) else []:
        if block.get("type") == "text":
            yield block.get("text") or ""
        elif block.get("type") == "tool_use":
            yield json.dumps(block.get("input"))
        elif block.get("type") == "tool_result":
            text = json.dumps(block.get("content"))
            if len(text) <= MAX_RESULT_CHARS:
                yield text


def session_refs(session_id):
    path = transcript(session_id)
    refs = {}
    if not path:
        return refs
    with open(path, errors="replace") as f:
        for line in f:
            if "http" not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if entry.get("type") not in ("user", "assistant"):
                continue
            for text in spoken(entry):
                for kind, pattern in REF_PATTERNS:
                    for m in pattern.finditer(text):
                        ident = m.group(1).rstrip(".,;:")
                        key = (kind, ident)
                        # First pattern to match a URL wins, so a PR is not
                        # also counted as a bare link.
                        if any(k[1] in ident and k[0] != kind for k in refs):
                            continue
                        ref = refs.setdefault(key, {"kind": kind, "id": ident, "count": 0, "last": ""})
                        ref["count"] += 1
                        ref["last"] = max(ref["last"], entry.get("timestamp") or "")
    return refs


def list_refs():
    panes = agent_panes()
    scope = state().get("refs_pane")
    chosen = [p for p in panes if p["pane_id"] == scope and p.get("agent_session")]
    if not chosen:
        chosen = [p for p in panes if p.get("agent_session")]
    several = len(chosen) > 1
    merged = {}
    for p in chosen:
        for key, ref in session_refs(p["agent_session"]["value"]).items():
            ref["where"] = p["where"]
            if key not in merged or ref["last"] > merged[key]["last"]:
                merged[key] = ref
    message("Links from {}".format(
        "every agent session" if several else chosen[0]["where"] if chosen else "no agent session"), BOLD)
    for kind, label_text in REF_KINDS:
        mine = sorted((r for r in merged.values() if r["kind"] == kind),
                      key=lambda r: r["last"], reverse=True)
        for ref in mine:
            row(kind, ref["id"], REF_URL[kind] + ref["id"], "", "{} {} {}".format(
                c("{:<6}".format(label_text), CYAN), c("×{:<3}".format(ref["count"]), DIM), ref["id"][:90]))


# ---- PRs

def fetch_prs():
    """My open PRs, via the gh CLI."""
    if not shutil.which("gh"):
        raise RuntimeError("gh is not installed; see https://cli.github.com")
    args = ["gh", "search", "prs"] + shlex.split(config()["pr_search"]) + [
        "--limit", "40", "--json", "number,title,url,repository,isDraft"]
    r = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, universal_newlines=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip()[:200] or "gh search prs failed")
    return json.loads(r.stdout or "[]")


def prs(force=False):
    path = os.path.join(CACHE, "prs.json")
    cached = load(path, None)
    if cached and not force and time.time() - cached.get("at", 0) < PR_TTL:
        return cached["value"], None
    try:
        value = fetch_prs()
    except (RuntimeError, OSError, ValueError) as e:
        return (cached or {}).get("value") or [], "{}".format(e)
    save(path, {"at": time.time(), "value": value})
    return value, None


def list_prs(force):
    found, error = prs(force)
    if error:
        message(error, RED)
    for pr in found:
        repo = (pr.get("repository") or {}).get("nameWithOwner") or ""
        kind = "draft" if pr.get("isDraft") else "open"
        row("pr", str(pr.get("number")), pr.get("url") or "", "", "{} {} {}".format(
            c("{:<7}".format(kind), YELLOW if kind == "open" else DIM),
            c("{:<28}".format(repo[:28]), DIM), (pr.get("title") or "")[:90]))


# ---- acting on rows

def fzf_arg(text):
    for a, b in (("(", ")"), ("[", "]"), ("{", "}")):
        if a not in text and b not in text:
            return a + text + b
    return "(" + re.sub(r"[()]", " ", text) + ")"


def label(text):
    return "change-border-label" + fzf_arg(" {} ".format(text.replace("\n", " ")[:150]))


def switch(mode, **changes):
    set_state(mode=mode, **changes)
    return "reload({} _list)+change-prompt({}> )+change-header{}+clear-query+{}".format(
        SELF, mode, fzf_arg("{}\n{}".format(MODES[mode], KEYS)), label(mode))


def act(key, rows):
    st = state()
    if key == "esc":
        return "abort"
    if key == "reload":
        return "reload({} _list force)".format(SELF)
    rows = [r for r in rows if len(r) >= 4]
    if not rows:
        return ""
    kind, ident, url = rows[0][0], rows[0][1], rows[0][2]
    if key == "refs":
        return switch("refs", refs_pane=ident if kind == "pane" else st.get("origin"))
    if key == "open":
        urls = [r[2] for r in rows if r[2]]
        return label(open_urls(urls)) if urls else label("nothing to open")
    if key == "copy":
        text = "\n".join(r[1] if r[0] == "pane" else (r[2] or r[1]) for r in rows)
        to_clipboard(text)
        return label("copied " + text[:80])
    if kind == "pane":
        herdr("workspace", "focus", ident.split(":")[0])
        herdr("tab", "focus", rows[0][3])
        if any(p["pane_id"] == ident and p.get("agent") for p in herdr("pane", "list")["panes"]):
            herdr("agent", "focus", ident)
        return "abort"
    return label(open_urls([url])) if url else ""


def preview(kind, ident, url, aux):
    if kind == "pane":
        r = subprocess.run(["herdr", "pane", "read", ident, "--source", "recent", "--format", "ansi"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, universal_newlines=True)
        lines = r.stdout.rstrip().split("\n")
        print("\n".join(lines[-int(os.environ.get("FZF_PREVIEW_LINES", "40")):]))
        return
    if url:
        print(c(url, BLUE))
    if kind == "pr" and shutil.which("gh"):
        r = subprocess.run(["gh", "pr", "view", url, "--comments"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True)
        print(r.stdout[:4000])


def do_list(force):
    mode = state()["mode"]
    try:
        if mode == "agents":
            list_agents()
        elif mode == "prs":
            list_prs(force)
        else:
            list_refs()
    except (RuntimeError, OSError, ValueError, KeyError) as e:
        message("{}: {}".format(type(e).__name__, str(e)[:300]), RED)


def main_ui(mode):
    if not shutil.which("fzf"):
        sys.exit("hv needs fzf: https://github.com/junegunn/fzf")
    fd, path = tempfile.mkstemp(prefix="hv-state-")
    os.close(fd)
    os.environ["HV_STATE"] = path
    try:
        focused = plugin_context().get("focused_pane_id")
        if not focused:
            focused = next((p["pane_id"] for p in herdr("pane", "list")["panes"] if p.get("focused")), None)
    except (RuntimeError, OSError, ValueError) as e:
        sys.exit("hv needs a running herdr: {}".format(e))
    set_state(mode=mode, origin=focused, refs_pane=focused)
    hv = shlex.quote(SELF)
    binds = ["enter:transform({} _act enter {{+f}})".format(hv), "esc:transform({} _act esc)".format(hv),
             "ctrl-o:transform({} _act open {{+f}})".format(hv), "ctrl-y:transform({} _act copy {{+f}})".format(hv),
             "ctrl-l:transform({} _act reload)".format(hv), "ctrl-r:transform({} _act refs {{+f}})".format(hv)]
    binds += ["{}:transform({} _switch {})".format(key, hv, m) for key, m in
              (("ctrl-a", "agents"), ("ctrl-p", "prs"))]
    try:
        subprocess.run(["fzf", "--ansi", "--multi", "--delimiter", "\t", "--with-nth", "5",
                        "--layout", "reverse", "--border", "--border-label", " {} ".format(mode),
                        # Without --no-hscroll fzf slides matched lines sideways to
                        # reveal the match, which destroys the column alignment.
                        "--no-hscroll", "--ellipsis", "…",
                        "--prompt", mode + "> ", "--header", "{}\n{}".format(MODES[mode], KEYS),
                        "--preview", "{} _preview {{1}} {{2}} {{3}} {{4}}".format(hv),
                        "--preview-window", "right,45%,wrap,<70(down,45%,wrap)",
                        "--bind", "start:reload({} _list)".format(hv),
                        "--bind", ",".join(binds)], stdin=subprocess.DEVNULL)
    finally:
        os.unlink(path)


# ---- tree: spaces > tabs > agents, foldable, in a popup

URGENCY = {"blocked": 4, "done": 3, "working": 2, "idle": 1, "unknown": 0}
TREE_FOLDS = os.path.join(CACHE, "tree-folds.json")
TREE_REFRESH_MS = 2000


def tree_nodes():
    """Spaces, their tabs and each tab's agents. A space with one tab skips the
    tab level, so the tree only nests where there is something to tell apart."""
    spaces = herdr("workspace", "list")["workspaces"]
    tabs = herdr("tab", "list")["tabs"]
    panes = herdr("pane", "list")["panes"]
    roots = []
    for ws in sorted(spaces, key=lambda w: w.get("number") or 0):
        space = {"kind": "space", "id": ws["workspace_id"], "label": ws.get("label") or "?", "children": []}
        mine = sorted([t for t in tabs if t["workspace_id"] == ws["workspace_id"]], key=lambda t: t.get("number") or 0)
        for t in mine:
            tab = {"kind": "tab", "id": t["tab_id"], "label": t.get("label") or str(t.get("number") or "?"),
                   "children": []}
            for p in panes:
                if p["tab_id"] == t["tab_id"] and p.get("agent"):
                    tab["children"].append({
                        "kind": "agent", "id": p["pane_id"], "agent": p["agent"], "children": [],
                        "status": p.get("agent_status") or "unknown",
                        "label": p.get("terminal_title_stripped") or p["agent"]})
            if len(mine) == 1:
                space["children"].extend(tab["children"])
            else:
                space["children"].append(tab)
        roots.append(space)
    return roots


def subtree_statuses(node):
    if node["kind"] == "agent":
        return [node["status"]]
    out = []
    for c in node["children"]:
        out += subtree_statuses(c)
    return out


def tree_rows(roots, folded):
    rows = []

    def walk(node, depth, parent):
        rows.append({"node": node, "depth": depth, "parent": parent})
        if node["children"] and node["id"] not in folded:
            for c in node["children"]:
                walk(c, depth + 1, node)
    for r in roots:
        walk(r, 0, None)
    return rows


def tree_path(roots, target):
    """The nodes from a root down to target, or [] when it is not in the tree."""
    for r in roots:
        if r["id"] == target:
            return [r]
        below = tree_path(r["children"], target)
        if below:
            return [r] + below
    return []


def tree_ui():
    import curses
    os.environ.setdefault("ESCDELAY", "25")
    folded = set(load(TREE_FOLDS, []))
    origin = plugin_context().get("focused_pane_id")
    if not origin:
        try:
            origin = focused_pane()
        except (RuntimeError, OSError, ValueError):
            origin = None

    def run(scr):
        curses.curs_set(0)
        curses.use_default_colors()
        colors = {}
        for i, (name, c) in enumerate((("blocked", curses.COLOR_RED), ("working", curses.COLOR_YELLOW),
                                       ("done", curses.COLOR_GREEN), ("idle", -1), ("unknown", -1)), 1):
            curses.init_pair(i, c, -1)
            colors[name] = curses.color_pair(i) | (curses.A_DIM if c == -1 else 0)
        scr.timeout(TREE_REFRESH_MS)
        sel_id, top, msg = origin, 0, ""

        def refresh(old):
            # a herdr hiccup keeps the last tree on screen instead of closing the popup
            try:
                return tree_nodes(), ""
            except (RuntimeError, OSError, ValueError, KeyError) as e:
                return old, "refresh failed: " + str(e)[:50]

        roots, msg = refresh([])
        for anc in tree_path(roots, origin):  # start on the origin, or the fold that hides it
            if anc["id"] in folded:
                sel_id = anc["id"]
                break
        while True:
            rows = tree_rows(roots, folded)
            ids = [r["node"]["id"] for r in rows]
            sel = ids.index(sel_id) if sel_id in ids else 0
            h, w = scr.getmaxyx()
            body = max(1, h - 2)
            top = min(max(top, sel - body + 1), sel)
            scr.erase()
            scr.addnstr(0, 0, " spaces · j/k move · h/l fold · space toggle · enter go · q quit  " + msg,
                        w - 1, curses.A_BOLD)
            for y, r in enumerate(rows[top:top + body], 1):
                n = r["node"]
                statuses = subtree_statuses(n)
                worst = max(statuses, key=lambda s: URGENCY.get(s, 0)) if statuses else "unknown"
                arrow = " " if not n["children"] else ("▸" if n["id"] in folded else "▾")
                indent = "  " * r["depth"]
                attr = curses.A_REVERSE if top + y - 1 == sel else 0
                glyph = STATUS_GLYPH.get(worst, " ") if statuses else " "
                if n["kind"] == "agent":
                    text = "{}{} {} {:<40} {}".format(indent, arrow, glyph, n["label"][:40], n["status"])
                else:
                    counts = ""
                    if n["id"] in folded or n["kind"] == "space":
                        tally = {}
                        for st in statuses:
                            tally[st] = tally.get(st, 0) + 1
                        counts = "  " + " ".join("{}{}".format(STATUS_GLYPH[k], tally[k])
                                                 for k in ("blocked", "done", "working", "idle") if k in tally)
                    text = "{}{} {} {}{}".format(indent, arrow, glyph, n["label"], counts)
                    attr |= curses.A_BOLD if n["kind"] == "space" else 0
                scr.addnstr(y, 0, text.ljust(w - 1), w - 1, attr | colors.get(worst, 0))
            scr.refresh()
            k = scr.getch()
            msg = ""
            if k == -1:
                roots, msg = refresh(roots)
                continue
            # a paste arrives as a burst; with a line break in it, it is text,
            # not keys, so none of it moves, folds or jumps
            scr.nodelay(True)
            burst = []
            while True:
                x = scr.getch()
                if x == -1:
                    break
                burst.append(x)
            scr.timeout(TREE_REFRESH_MS)
            if burst and any(c in (10, 13) for c in [k] + burst):
                msg = "paste ignored"
                continue
            if k in (ord("q"), 27):
                return
            if not rows:
                continue
            cur = rows[sel]
            n = cur["node"]
            if k in (ord("j"), curses.KEY_DOWN):
                sel_id = ids[min(sel + 1, len(ids) - 1)]
            elif k in (ord("k"), curses.KEY_UP):
                sel_id = ids[max(sel - 1, 0)]
            elif k == ord("g"):
                sel_id = ids[0]
            elif k == ord("G"):
                sel_id = ids[-1]
            elif k in (ord("h"), curses.KEY_LEFT):
                if n["children"] and n["id"] not in folded:
                    folded.add(n["id"])
                elif cur["parent"]:
                    sel_id = cur["parent"]["id"]
            elif k in (ord("l"), curses.KEY_RIGHT):
                folded.discard(n["id"])
            elif k == ord(" "):
                if n["children"]:
                    folded.symmetric_difference_update({n["id"]})
            elif k == ord("r"):
                roots, msg = refresh(roots)
            elif k in (10, 13, curses.KEY_ENTER):
                try:
                    if n["kind"] == "agent":
                        herdr("agent", "focus", n["id"])
                    elif n["kind"] == "tab":
                        herdr("tab", "focus", n["id"])
                    else:
                        herdr("workspace", "focus", n["id"])
                    return
                except (RuntimeError, OSError, ValueError) as e:
                    msg = str(e)[:60]
            save(TREE_FOLDS, sorted(folded))

    try:
        curses.wrapper(run)
    finally:
        save(TREE_FOLDS, sorted(folded))


# ---- the sidebar: a faked tree, and an attention queue

def annotate_spaces(spaces):
    """Writes each space's agents into workspace metadata as $hv_a1..$hv_aN.

    Herdr has no tree or fold API for the sidebar, so the nesting is faked: the
    space row template in config.toml has a fixed set of rows, and these tokens
    fill them.
    """
    for ws in herdr("workspace", "list")["workspaces"]:
        mine = sorted(spaces.get(ws["workspace_id"]) or [], key=lambda p: p["where"])
        tabs = sorted({p["tab_id"] for p in mine})
        items = []  # (depth, glyph, text); tabs become a level only when a space has several
        for tab in tabs:
            agents = [p for p in mine if p["tab_id"] == tab]
            if len(tabs) > 1:
                worst = max((p.get("agent_status") or "unknown" for p in agents), key=lambda s: URGENCY.get(s, 0))
                items.append((0, SPACE_GLYPH.get(worst, "○"), "tab " + agents[0]["where"].split(" / ", 1)[-1]))
            for p in agents:
                title = p.get("terminal_title_stripped") or p.get("agent") or "agent"
                items.append((1 if len(tabs) > 1 else 0,
                              SPACE_GLYPH.get(p.get("agent_status") or "unknown", "○"), title))
        lines = []
        for i, (depth, glyph, text) in enumerate(items[:SPACE_ROWS]):
            last = i == len(items) - 1 or (i + 1 < len(items) and items[i + 1][0] < depth)
            if depth == 0:
                branch = "└─" if not any(d == 0 for d, _, _ in items[i + 1:]) else "├─"
            else:
                more_top = any(d == 0 for d, _, _ in items[i + 1:])
                branch = ("│ " if more_top else "  ") + ("└─" if last else "├─")
            line = "{} {} {}".format(branch, glyph, text)
            lines.append(" " + line[:SIDEBAR_TEXT])
        if len(items) > SPACE_ROWS:
            lines[-1] = " └─ +{} more".format(len(items) - SPACE_ROWS + 1)
        args = ["workspace", "report-metadata", ws["workspace_id"], "--source", ANNOTATE_SOURCE,
                "--ttl-ms", str(TOKEN_TTL_MS)]
        for i in range(SPACE_ROWS):
            name = "hv_a{}".format(i + 1)
            args += ["--token", "{}={}".format(name, lines[i])] if i < len(lines) else ["--clear-token", name]
        try:
            herdr(*args)
        except (RuntimeError, OSError, ValueError):
            continue


def annotate_status():
    """The tree, from live pane status only. Cheap enough to run every few seconds."""
    spaces = {}
    for p in agent_panes():
        if p.get("agent"):
            spaces.setdefault(p["workspace_id"], []).append(p)
    annotate_spaces(spaces)


def annotate_prs():
    """Tags each agent pane with the PR for the repo it is working in."""
    found, _ = prs()
    by_repo = {}
    for pr in found:
        repo = (pr.get("repository") or {}).get("nameWithOwner") or ""
        if repo:
            by_repo.setdefault(repo.split("/")[-1], pr)
    for p in agent_panes():
        if not p.get("agent_session"):
            continue
        cwd = p.get("foreground_cwd") or p.get("cwd") or ""
        pr = by_repo.get(os.path.basename(cwd.rstrip("/")))
        args = ["pane", "report-metadata", p["pane_id"], "--source", ANNOTATE_SOURCE,
                "--ttl-ms", str(TOKEN_TTL_MS)]
        if pr:
            args += ["--token", "hv_pr=#{}".format(pr.get("number")),
                     "--token", "hv_pr_state={}".format("draft" if pr.get("isDraft") else "open")]
        else:
            for name in TOKEN_NAMES:
                args += ["--clear-token", name]
        try:
            herdr(*args)
        except (RuntimeError, OSError, ValueError):
            continue


def set_agent_view():
    """Reduces herdr's Agents panel to agents that want a human.

    Blocked means it is asking something; done means it finished and has not
    been seen. Everything else stays visible in the spaces tree, so nothing is
    lost by keeping this panel short.
    """
    return socket_request("agent.view.set", {
        "source": "plugin:" + (os.environ.get("HERDR_PLUGIN_ID") or "local.herdr-views"),
        "label": "needs you",
        "filter": {"op": "in", "field": "status", "values": ["blocked", "done"]},
        "sort": [{"field": "attention", "order": "desc"},
                 {"field": "state_change_seq", "order": "desc"}],
    })


def annotate_loop():
    """Two speeds: status often, PRs rarely.

    Herdr asks plugins not to leave detached processes behind and startup hooks
    exit immediately, so this watches for the server's socket disappearing and
    stops rather than outliving the server that started it.
    """
    path = socket_path()
    threading.Thread(target=focus_loop, daemon=True).start()
    try:
        set_agent_view()
    except (RuntimeError, OSError, ValueError) as e:
        sys.stderr.write("view: {}\n".format(e))
    last_prs = 0.0
    while True:
        steps = [("status", annotate_status)]
        if time.time() - last_prs > PR_EVERY:
            steps.append(("prs", annotate_prs))
            last_prs = time.time()
        for name, step in steps:
            try:
                step()
            except (RuntimeError, OSError, ValueError, KeyError) as e:
                sys.stderr.write("{}: {}: {}\n".format(name, type(e).__name__, e))
                sys.stderr.flush()
        time.sleep(STATUS_EVERY)
        if not os.path.exists(path):
            return


# ---- travel: focus history (back / forward) and the top of the queue

HISTORY = os.path.join(CACHE, "focus.json")
HISTORY_MAX = 100
JUMP_TTL = 3.0  # seconds a back/forward jump waits for herdr to confirm it


def socket_path():
    return os.environ.get("HERDR_SOCKET_PATH") or os.path.join(HOME, ".config", "herdr", "herdr.sock")


def history():
    h = load(HISTORY, {})
    h.setdefault("panes", [])
    h.setdefault("at", len(h["panes"]) - 1)
    return h


def pending_jump(h):
    j = h.get("jump")
    return j if j and time.time() - j.get("t", 0) < JUMP_TTL else None


def record_focus(pane_id):
    """Called for every focus change. A change we caused by back/forward moves
    the cursor; any other one drops the forward part and appends, like a browser."""
    if not pane_id:
        return
    with locked(HISTORY):  # back/forward writes the same file
        h = history()
        panes, at = h["panes"], h["at"]
        j = pending_jump(h)
        if j and j["pane"] == pane_id:
            h["at"] = j["at"]
        elif 0 <= at < len(panes) and panes[at] == pane_id:
            pass
        else:
            panes = panes[:at + 1] + [pane_id]
            if len(panes) > HISTORY_MAX:
                panes = panes[-HISTORY_MAX:]
            h["panes"], h["at"] = panes, len(panes) - 1
        h.pop("jump", None)
        save(HISTORY, h)


def focused_pane():
    for p in herdr("pane", "list")["panes"]:
        if p.get("focused"):
            return p["pane_id"]
    return None


def focus_loop():
    """Follows herdr's focus events into the history. Tab and space switches
    move focus without a pane event, so those look up the focused pane."""
    kinds = ["pane.focused", "tab.focused", "workspace.focused"]
    while os.path.exists(socket_path()):
        try:
            record_focus(focused_pane())
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(socket_path())
            sock.sendall((json.dumps({"id": "hv-focus", "method": "events.subscribe",
                                      "params": {"subscriptions": [{"type": k} for k in kinds]}}) + "\n").encode("utf-8"))
            buf = b""
            while True:
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    msg = json.loads(line.decode("utf-8"))
                    data = msg.get("data") or {}
                    if data.get("type") == "pane_focused":
                        record_focus(data.get("pane_id"))
                    elif msg.get("event") in ("tab_focused", "workspace_focused") or \
                            data.get("type") in ("tab_focused", "workspace_focused"):
                        record_focus(focused_pane())
            sock.close()
        except (RuntimeError, OSError, ValueError, KeyError) as e:
            sys.stderr.write("focus: {}: {}\n".format(type(e).__name__, e))
            sys.stderr.flush()
        time.sleep(1)


def go(pane_id, agent=False):
    """Focuses a pane wherever it is, switching tab and space as needed."""
    if agent:
        herdr("agent", "focus", pane_id)
    else:
        socket_request("pane.focus", {"pane_id": pane_id})


def step(direction):
    """back (-1) or forward (+1) through the history, skipping closed panes."""
    live = {p["pane_id"] for p in herdr("pane", "list")["panes"]}
    here = focused_pane()
    with locked(HISTORY):  # the focus loop writes the same file
        h = history()
        panes = h["panes"]
        j = pending_jump(h)
        at = j["at"] if j else h["at"]
        i = at + direction
        while 0 <= i < len(panes) and (panes[i] not in live or panes[i] == here):
            i += direction
        if not 0 <= i < len(panes):
            return "no further " + ("back" if direction < 0 else "forward")
        h["jump"] = {"pane": panes[i], "at": i, "t": time.time()}
        save(HISTORY, h)
    go(panes[i])
    return "→ " + panes[i]


def needs_you():
    """The top of the "needs you" queue: blocked agents first (they are asking
    something), then done ones, newest change first. Pressing it again while
    on that agent moves to the next one."""
    agents = [a for a in herdr("agent", "list")["agents"]
              if a.get("agent_status") in ("blocked", "done")]
    if not agents:
        return "no agent needs you"
    agents.sort(key=lambda a: (a.get("agent_status") != "blocked", -(a.get("state_change_seq") or 0)))
    pick = next((a for a in agents if not a.get("focused")), agents[0])
    go(pick["pane_id"], agent=True)
    return "→ " + pick["pane_id"]


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "agents"
    if cmd == "_list":
        do_list(force=args[1:] == ["force"])
    elif cmd == "_preview":
        preview(*(args[1:5] + [""] * 4)[:4])
    elif cmd == "_switch":
        print(switch(args[1]))
    elif cmd == "_act":
        rows = []
        if len(args) > 2:
            with open(args[2]) as f:
                rows = [line.rstrip("\n").split("\t") for line in f]
        try:
            print(act(args[1], rows))
        except (RuntimeError, OSError, ValueError, KeyError) as e:
            print(label("{}: {}".format(type(e).__name__, e)))
    elif cmd == "_annotate":
        annotate_status()
        annotate_prs()
        set_agent_view()
        print("annotated")
    elif cmd == "_annotate_loop":
        annotate_loop()
    elif cmd == "tree":
        tree_ui()
    elif cmd in ("back", "forward", "needs-you"):
        try:
            msg = needs_you() if cmd == "needs-you" else step(-1 if cmd == "back" else 1)
        except (RuntimeError, OSError, ValueError, KeyError) as e:
            msg = "{}: {}".format(type(e).__name__, e)
        print(msg)
    elif cmd in MODES:
        main_ui(cmd)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
